# GHOST HOST — copy this file to .env and edit values. Never commit .env.

# Owner console password (set your own — it is never shown in the UI)
ADMIN_PASSWORD=change-me

# Secret used to sign sessions and encrypt Railway tokens / MongoDB URLs
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=change-me-to-a-long-random-string

# Port for the panel
PORT=3000

# Maximum ZIP upload size in MB
MAX_ZIP_MB=1024

# ZIP safety limits
MAX_ENTRIES=20000
MAX_EXTRACT_GB=4

# How long a deployment job may wait for Railway status (minutes)
DEPLOY_TIMEOUT_MIN=25

# How many deployments run at the same time
MAX_RUNNING=2
PUBLIC_DEPLOYS_PER_HOUR=8
PUBLIC_ACTIVE_JOBS=2

# MongoDB (optional). Multiple URLs allowed, separated by commas or new lines.
# If one stops working, GHOST HOST automatically tries the next one.
# MONGODB_URLS=mongodb+srv://user:pass@cluster0.mongodb.net
# MONGODB_DB=ghosthost
